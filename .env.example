# Databricks Configuration
# Copy this file to .env and fill in your actual values

# Your Databricks workspace URL
DATABRICKS_HOST=https://your-workspace.databricks.com

# Your Databricks personal access token
DATABRICKS_TOKEN=your-personal-access-token

# SQL Warehouse HTTP Path (required for Genie space deployment)
# Format: /sql/1.0/warehouses/<warehouse-id>
# Find this in your SQL Warehouse settings under "Connection Details"
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Model Configuration
# LLM model for text-based tasks (enrichment, config generation)
LLM_MODEL=databricks-gpt-5-2

# Vision model for image-based PDF parsing (faster models recommended)
# Recommended: databricks-claude-sonnet-4 (13.7s per page)
# Alternative: databricks-claude-sonnet-4-5 (14.0s per page)
VISION_MODEL=databricks-claude-sonnet-4
